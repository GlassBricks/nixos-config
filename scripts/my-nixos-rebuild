#!/usr/bin/env python3
import argparse
import sys

from nixos_common import (
    commit_and_push,
    rebuild,
    resolve_commit_message,
    run,
    setup_env,
    staged_files,
)

setup_env()

parser = argparse.ArgumentParser()
parser.add_argument("-a", "--all", action="store_true", help="rebuild both nixos and home")
parser.add_argument("-n", "--nixos", action="store_true", help="force nixos rebuild")
parser.add_argument("-H", "--home", action="store_true", help="force home-manager rebuild")
parser.add_argument("-m", "--message", help="commit message (skip prompt)")
parser.add_argument("-g", "--generate", action="store_true", help="generate commit message with claude (skip prompt)")
parser.add_argument("-C", "--no-commit", action="store_true", help="skip commit/push; just git add + rebuild")
args = parser.parse_args()

run("git add .")
run("alejandra .")
run("git add .")

force = args.all or args.nixos or args.home
changed_files = staged_files()

if not changed_files and not force:
    print("No changes to commit.")
    sys.exit(0)

# Any rebuild flag forces those targets and overrides detection; otherwise infer
# targets from changed paths.
if force:
    should_update_nixos = args.all or args.nixos
    should_update_home = args.all or args.home
else:
    change_all_strs = ["flake.", "modules/", "overlays/", "pkgs/"]
    should_update_all = any(
        f.startswith(s) for f in changed_files for s in change_all_strs
    )
    should_update_nixos = should_update_all or any(f.startswith("nixos/") for f in changed_files)
    should_update_home = should_update_all or any(f.startswith("home-manager/") for f in changed_files)

print("update nixos:", should_update_nixos)
print("update home:", should_update_home)

should_commit = changed_files and not args.no_commit

# Resolve the commit message up front so the long build runs unattended.
if should_commit:
    commit_msg = resolve_commit_message(args.message, args.generate)

rebuild(should_update_nixos, should_update_home)

if should_commit:
    commit_and_push(commit_msg)
